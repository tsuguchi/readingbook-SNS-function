# =============================================================================
# 開発環境用の環境変数サンプル
# このファイルを `.env` にコピーして使用してください
# `.env` は .gitignore で除外されています
# =============================================================================

# ---- データベース (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
POSTGRES_DB=readingbook_development

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (開発用 S3 互換ストレージ) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=readingbook-dev

# ---- サービスポート ----
# Next.js（フロントエンド）
FRONTEND_PORT=3000
# Rails API（バックエンド）
BACKEND_PORT=3001
# Sidekiq Web UI（任意）
SIDEKIQ_PORT=3002

# ---- Rails ----
RAILS_ENV=development
# `bin/rails secret` で生成したものに置換してください
SECRET_KEY_BASE=development_secret_key_base_change_me
# `bin/rails secret` で生成したものに置換してください
DEVISE_JWT_SECRET_KEY=development_jwt_secret_change_me

# ---- フロントエンド ----
NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# ---- 接続 URL（Rails / Sidekiq から参照） ----
DATABASE_URL=postgres://postgres:password@postgres:5432/readingbook_development
REDIS_URL=redis://redis:6379/0
